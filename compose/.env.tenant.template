# Copy outside Git and replace every placeholder. Never put secrets into Terraform.
TENANT_ID=acme
DOMAIN=sign.acme.example
# Supply verified accessible images; no published digest is implied by this template.
APP_IMAGE=ghcr.io/stalfe-cloud/docurama-enterprise@sha256:REPLACE_WITH_VERIFIED_DIGEST
EDGE_IMAGE=nginx@sha256:REPLACE_WITH_VERIFIED_DIGEST
DOCURAMA_DEPLOYMENT_MODE=private_cloud
DOCURAMA_PUBLIC_REGISTRATION=false
S3_BUCKET=REPLACE_FROM_TERRAFORM_OUTPUT
S3_REGION=eu-west-3
S3_CREDENTIALS_MODE=default
S3_AUTO_CREATE_BUCKET=0
S3_SSE_KMS_KEY_ID=REPLACE_FROM_TERRAFORM_OUTPUT
# Disable public transparency submissions until separately authorized.
REKOR_WITNESS=off
# Optional SMTP relay; percent-encode reserved URI characters in credentials.
SMTP_URL=
# Optional operator-verified mailbox, e.g. notifications@your-verified-domain.example.
# Blank inherits the privileged platform SMTP identity; no sender is fabricated.
SMTP_FROM=
